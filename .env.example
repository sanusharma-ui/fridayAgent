# Save this as .env in the project root (beside main.py), or set environment variables.
# Existing environment variables take precedence. Do not commit real keys.
FRIDAY_API_KEY=your_friday_api_key
AI_ENDPOINT_URL=https://preconceptional-roland-nondisposable.ngrok-free.dev
# Optional Groq fallback. It is disabled unless explicitly enabled.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENWEATHER_API_KEY=
DEFAULT_CITY=Nagpur
ASSISTANT_NAME=FRIDAY
# Controlled browser: chrome (installed Google Chrome), msedge, or chromium.
BROWSER_CHANNEL=chrome

# Optional Telegram remote access. Create your own bot using @BotFather.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Numeric user IDs, comma separated. Empty means /id setup only, no tasks.
TELEGRAM_ALLOWED_USER_IDS=
# Multilingual model; first voice note downloads it to the user model cache.
TELEGRAM_WHISPER_MODEL=base
# Empty = detect language; use en or hi to fix it if detection is unreliable.
TELEGRAM_VOICE_LANGUAGE=
