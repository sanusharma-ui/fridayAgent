# Save this as .env in the project root (beside main.py), or set environment variables.
# Existing environment variables take precedence. Do not commit real keys.
FRIDAY_API_KEY=your_friday_api_key
AI_ENDPOINT_URL=https://preconceptional-roland-nondisposable.ngrok-free.dev
# Optional Groq fallback. It is disabled unless explicitly enabled.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENWEATHER_API_KEY=
DEFAULT_CITY=Nagpur
ASSISTANT_NAME=FRIDAY
# Controlled browser: chrome (installed Google Chrome), msedge, or chromium.
BROWSER_CHANNEL=chrome

# Optional Gmail read/summarize and confirmed sending. Restart after changing.
# Enable Gmail API in your Google Cloud project and configure OAuth consent.
# Authorize BOTH scopes: https://www.googleapis.com/auth/gmail.readonly
# and https://www.googleapis.com/auth/gmail.send (see README setup).
# OAuth client credentials and a refresh token, NOT your Gmail password/API key.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Summaries use FRIDAY_API_KEY / AI_ENDPOINT_URL above (and enabled Groq fallback).

# Optional Telegram remote access. Create your own bot using @BotFather.
# Set true to connect on startup. Keep the laptop awake and app running.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Numeric user IDs, comma separated. Empty means /id setup only, no tasks.
# Connect with the token, send /id to your bot, copy the ID here, then restart.
TELEGRAM_ALLOWED_USER_IDS=
# Multilingual model; first voice note downloads it to the user model cache.
TELEGRAM_WHISPER_MODEL=base
# Empty = detect language; use en or hi to fix it if detection is unreliable.
# Send a Telegram microphone voice note (max 60s / 10 MB); /voice shows help.
TELEGRAM_VOICE_LANGUAGE=
